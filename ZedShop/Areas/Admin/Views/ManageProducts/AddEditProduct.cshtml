@model ZedShop.Web.Areas.Admin.Models.ProductViewModel.ProductAEViewModelAdmin

@{
    @if (ViewBag.EditMode){
        ViewData["Title"] = "ویرایش کالا";
    }else{
        ViewData["Title"] = "افزودن کالا";
    }
    
    Layout = "~/areas/admin/views/shared/_AdminLayout.cshtml";

}

<div class="col-12">
    <div class="card">
        <div class="card-body">

            @if (ViewBag.EditMode)
            {
                <h4 class="card-title"><strong> ویرایش کالا </strong></h4>

            }
            else
            {
                <h4 class="card-title"><strong> افزودن کالا </strong></h4>

            }
            <form asp-action="@ViewBag.ActionName" asp-controller="ManageProducts" method="post" enctype="multipart/form-data">

                 <div class="row-form-container">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="ProductId" class="form-control" />
                    <input type="hidden" asp-for="ProductImageName" class="form-control" />

                    <div class="simple-center-div" style="margin-top:20px; margin-bottom:20px;">
                        <figure>
                            <img src="/Products/Image/@Model.ProductImageName" alt="Image" class="edit-user-img" style="width:200px; height:150px;">
                        </figure>
                    </div>

                    <div class="row-form">
                        <div class="left" style="width: 50%;">
                            <div class="form-group">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>


                            <div class="form-group">
                                <label asp-for="SellPrice" class="control-label"></label>
                                <input type="number" asp-for="SellPrice" class="form-control">
                                <span asp-validation-for="SellPrice" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="BuyDateSTR" class="control-label"></label>
                                <div class="input-group">
                                    <div class="input-group-addon" data-mddatetimepicker="true" data-trigger="click" data-targetselector="#dateinput">
                                        <span class="glyphicon glyphicon-calendar"></span>
                                    </div>
                                    <input type="text" asp-for="BuyDateSTR" class="form-control" id="dateinput" placeholder="تاریخ" data-mddatetimepicker="true" data-placement="right" data-englishnumber="true" />
                                </div>
                                <span asp-validation-for="BuyDateSTR" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label>انتخاب تصویر</label>
                                <input asp-for="ProductImageFile" type="file">
                            </div>
                            
                        </div>

                        <div class="right" style="width: 50%;">


                            <div class="form-group">
                                <label asp-for="Count" class="control-label"></label>
                                <input type="number" asp-for="Count" class="form-control" step="1" id="PCount">
                                <span asp-validation-for="Count" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="DisCount" class="control-label"></label>
                                <input type="number" asp-for="DisCount" class="form-control" step="0.01" id="PDisCount">
                                <span asp-validation-for="DisCount" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Description" class="control-label"></label>
                                <textarea asp-for="Description" rows="2" class="form-control"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="form-auth-row">
                                <label for="IsActivate" class="ui-checkbox">
                                    <input asp-for="IsActivate" type="checkbox">
                                    <span class="ui-checkbox-check"></span>
                                </label>
                                <label for="IsActivate">کالا فعال شده</label>
                            </div>
                            
                        </div>
                    </div> 


                    <div class="simple-center-div" style="margin-top:20px; margin-bottom:20px;">
                        <div class="form-group">
                            <input type="submit" value="ذخیره" class="btn btn-success" />
                            <button class="btn btn-warning btn-sm" asp-action="Index">انصراف</button>
                        </div>
                    </div>
                </div> 
            </form>

        </div>
    </div>
</div>



<script src="~/AdminLTE/datepicker/scripts/MdBootstrapPersianDateTimePicker/calendar.js" type="text/javascript"></script>
<script src="~/AdminLTE/datepicker/scripts/MdBootstrapPersianDateTimePicker/jquery.Bootstrap-PersianDateTimePicker.js" type="text/javascript"></script>

<script>
    var input = document.querySelector("[id='PCount']");

    input.addEventListener("input", function () {
        var value = this.value;
        if (value < 1) {
            this.value = 1;
        }
        if (value > @Model.Count) {
            this.value = @Model.Count;
        }
    })
</script>

<script>
    var input = document.querySelector("[id='PDisCount']");

    input.addEventListener("input", function () {
        var value = this.value;
        if (value < 0) {
            this.value = 0;
        }
        if (value > 0.99) {
            this.value = 0.99;
        }
    })
</script>