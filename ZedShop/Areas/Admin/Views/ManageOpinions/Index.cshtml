@model List<ZedShop.Web.Areas.Admin.Models.OpinionViewModel.OpinionViewModelAdmin>
@{
    ViewData["Title"] = "مدیریت نظرها";
    Layout = "~/areas/admin/views/shared/_AdminLayout.cshtml";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div style="display:flex;">

                    <p class="card-title"> <strong>نظرها</strong> </p>


                    <p class="card-title" style="margin-top:15px;margin-right:2%;font-size:16px; "> فیلتر:  </p>
                    <select id="filter-select" style="margin-right:5px; width:15%" onclick="AllOpinionsOfFilter()">

                        @foreach (var item in ViewBag.Filters)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }

                    </select>

                </div>


                <div id="basicgrid" class="m-t-40 jsgrid" style="position: relative; height: 750px; width: 100%;">
                    <div class="jsgrid-grid-header jsgrid-header-scrollbar">
                        <table class="jsgrid-table table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th style="max-width:4%; width:4%; text-align:center;">
                                        شناسه
                                    </th>
                                    <th style="max-width:12%; width:12%; text-align:center;">
                                        متن نظر
                                    </th>
                                    <th style="max-width:5%; width:5%; text-align:center;">
                                        تاریخ
                                    </th>
                                    <th style="max-width:5%; width:5%; text-align:center;">
                                        نام کاربر
                                    </th>
                                    <th style="max-width:5%; width:5%; text-align:center;">
                                        نمایش
                                    </th>
                                    <th style="max-width:5%; width:5%; text-align:center;">
                                        مسدود
                                    </th>
                                    <th style="max-width:10%; width:10%; text-align:center;">
                                        اقدامات
                                    </th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                    <div id="tableofopinioncontent">
                        @Html.Partial("_OpinionsTable")
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    function updateTableData(filterId, pageNum) {
        $.ajax({
            url: '/Admin/ManageOpinions/ChangePage/', // controller and action
            data: { _filterId: filterId, pageNumber: pageNum }, // Send the userInput as a parameter
            dataType: 'html',
            success: function (data) {

                $('#tableofopinioncontent').html(data); // Insert the received HTML into the container
            }
        });
    }

</script>


<script>
    function DeleteOpinion(id) {
        if (confirm("آیا از حذف نظر مطمعن هستید؟")) {
            $.ajax({
                type: 'POST',
                url: '/Admin/ManageOpinions/DeleteOpinion/', // controller and action
                data: { opinionId: id }, // Send the userInput as a parameter
                dataType: 'json',
                success: function (response) {
                    if (response.success) {
                        alert("نظر حذف شد‌!");
                        var myobj = document.getElementById(id);
                        myobj.remove();
                    } else {
                        alert("مشکلی پیش آمده!");
                    }
                }
            });
        }
    }

    function ShowOpinion(id) {
        if (confirm("آیا از تغیر وضعیت مخفی نمودن نظر مطمعن هستید؟")) {
            $.ajax({
                type: 'POST',
                url: '/Admin/ManageOpinions/ShowOpinion', // controller and action
                data: { opinionId: id },
                dataType: 'json',
                success: function (response) {
                    var myobj = document.getElementById('show_' + id);
                    if (response.resault) {
                        myobj.textContent = "بله";
                    } else {
                        myobj.textContent = "مخفی شده";
                    }
                }
            });
        }
    }

    function BanOpinion(id) {
        if (confirm("آیا از تغیر وضعیت مسدودیت دیدگاه نظر مطمعن هستید؟")) {
            $.ajax({
                type: 'POST',
                url: '/Admin/ManageOpinions/BanOpinion', // controller and action
                data: { opinionId: id },
                dataType: 'json',
                success: function (response) {
                    var myobj = document.getElementById('ban_' + id);
                    if (response.resault) {
                        myobj.textContent = "مسدود";
                    } else {
                        myobj.textContent = "خیر";
                    }
                }
            });
        }
    }

</script>

<script>
    function AllOpinionsOfFilter() {

        var filterElement = document.getElementById("filter-select");

        let id1 = filterElement.value;


        $.ajax({
            url: '/Admin/ManageOpinions/AllOpinionsOfFilter/', //controller and action
            data: { _filterId: id1 }, // Send the product ID as a parameter
            dataType: 'html',
            success: function (data) {
                $('#tableofopinioncontent').html(data); // Insert the received HTML into the container
            }
        });
    }
</script>