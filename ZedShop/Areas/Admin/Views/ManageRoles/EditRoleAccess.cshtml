@model ZedShop.Web.Areas.Admin.Models.UserViewModel.RoleAccessViewModel

@{
    ViewData["Title"] = "ویرایش نقش";
    Layout = "~/areas/admin/views/shared/_AdminLayout.cshtml";

}

@* /Admin/ManageRoles/EditRoleAccess/ *@

<label>دسترسی‌ها</label>

<div>
    <form asp-action="EditRoleAccess" asp-controller="ManageRoles" method="post">

        <input type="hidden" asp-for="Id" class="form-control" />
        <input type="hidden" asp-for="Name" class="form-control" />


        <ul>
            @foreach (var item in Model.Access)
            {
                <li>
                    <input asp-for="@item.IsActive" type="checkbox" />
                    @item.Name
                </li>
            }
        </ul>


        <label>@Model.Name</label>
