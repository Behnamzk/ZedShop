@model List<ZedShop.Web.Areas.Admin.Models.UserViewModel.RoleAccessViewModel>
@{
    ViewData["Title"] = "مدیریت نقش‌ها";
    Layout = "~/areas/admin/views/shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div style="display:flex;">

                    <p class="card-title"> <strong>نقش‌ها</strong> </p>


                </div>

                <div id="basicgrid" class="m-t-40 jsgrid" style="position: relative; height: 750px; width: 100%;">
                    <div class="jsgrid-grid-header jsgrid-header-scrollbar">
                        <table class="jsgrid-table table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th style="width:30%">
                                        نام نقش
                                    </th>
                                    <th style="width:70%; text-align:center;">
                                        اقدامات
                                    </th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                    <div id="tableofusercontent">
                        @Html.Partial("_RolesTable")
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>




<script>
    function DeleteRole(id) {
        if (confirm("آیا از حذف مطمین هستید؟")) {
            $.get("/Admin/Manageroles/DeleteRole/" + id,
                function (response) {
                    if (response.resault) {
                        alert("نقش حذف شد!");
                        var myobj = document.getElementById(id);
                        myobj.remove();
                    }else{
                        alert("کاربری با این نقش وجود دارد بنابراین نمی‌توان این نقش را حذف کرد!");
                    }

                });
        }
    }

</script>
