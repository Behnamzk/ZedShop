@using ZedShop.Core.DTOs.Order
@model OrderPurchaseViewModel
@{
    ViewData["Title"] = "تکمیل فرایند خرید";
}
<div class="col-12">
    <div class="card">
        <div class="card-body">

            <h4 class="card-title"><strong> ثبت آدرس و نهایی کردن سبد خرید </strong></h4>
            <form asp-action="CompletePurchase" asp-controller="Orders" method="post">

                <input type="hidden" asp-for="Id" class="form-control" />


                <div class="row-form-container">


                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row-form">
                        <div class="left" style="width: 50%;">

                            <div class="form-group" style="display: flex;">
                                <p style="margin-left:5%"><strong> استان محل سکونت:</strong></p>

                                <select id="province-select" class="chosen-select" asp-for="AddressVM.ProvinceId" style="width:50%" onclick="LoadCitiesByProvince()">
                                    <option value="-1">انتخاب استان</option>

                                    @foreach (var item in ViewBag.Provinces)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="AddressVM.ProvinceId" class="text-danger"></span>


                            <div class="form-group" style="margin-top:5%;">
                                <div class="form-group">
                                    <label asp-for="AddressVM.Address" class="control-label"></label>
                                    <textarea asp-for="AddressVM.Address" rows="5" class="form-control"></textarea>
                                    <span asp-validation-for="AddressVM.Address" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group" style="margin-top:4%;">
                                <label asp-for="AddressVM.PostalCode" class="control-label"></label>
                                <input asp-for="AddressVM.PostalCode" class="form-control" />
                                <span asp-validation-for="AddressVM.PostalCode" class="text-danger"></span>
                            </div>

@*                             <div class="d-flex mb-4">
                                <div class="form-group" style="width:50%;">
                                    <label asp-for="NameCode" class="control-label"></label>
                                    <input asp-for="NameCode" class="form-control" />
                                    <span asp-validation-for="NameCode" class="text-danger"></span>

                                </div>
                                <button type="button" class="btn btn-primary" style="height:50%; margin-top:4%;margin-right:2%; align-self:center" onclick="checkNameCode()">بررسی</button>
                                <label style=" margin-top:4%;margin-right:2%; align-self:center">بدون کد تخفیف</label>
                            </div> *@

                        </div>

                        <div class="right" style="width: 50%;">
                            <div class="form-group" style="display: flex;">
                                <p style="margin-left:5%"><strong> شهر محل سکونت:</strong></p>

                                <select id="cities-select" class="chosen-select" asp-for="AddressVM.CityId" style="width:50%">
                                    <option value="-1">انتخاب شهر</option>
                                </select>
                            </div>
                            <span asp-validation-for="AddressVM.CityId" class="text-danger"></span>


                            <div class="form-group" style="margin-top:5%;">
                                <label asp-for="AddressVM.CustomerFullName" class="control-label"></label>
                                <input asp-for="AddressVM.CustomerFullName" class="form-control" />
                                <span asp-validation-for="AddressVM.CustomerFullName" class="text-danger"></span>
                            </div>

                            <div class="form-group" >
                                <label asp-for="AddressVM.CustomerPhoneNum" class="control-label"></label>
                                <input asp-for="AddressVM.CustomerPhoneNum" class="form-control" />
                                <span asp-validation-for="AddressVM.CustomerPhoneNum" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="AddressVM.HouseNumber" class="control-label"></label>
                                <input asp-for="AddressVM.HouseNumber" class="form-control" />
                                <span asp-validation-for="AddressVM.HouseNumber" class="text-danger"></span>
                            </div>

@*                             <div style="margin-top:5%;">
                                <p><strong>مبلغ خرید:200000</strong></p>
                                <p><strong>هزینه پست:200000</strong></p>
                                <p><strong>مبلغ نهایی:200000</strong></p>


                            </div> *@

                        </div>
                    </div>


                    <div class="simple-center-div" style="margin-top:20px; margin-bottom:20px; text-align:center;">
                        <div class="form-group">
                            <input type="submit" value="نهایی کردن سبد خرید" class="input-submit" />
                            <button class="button-cancel" asp-action="Index">انصراف</button>
                        </div>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>
<script>
    function LoadCitiesByProvince() {

        var provinceSelectElement = document.getElementById("province-select");

        let provinceId = provinceSelectElement.value;

        if (provinceId != -1) {
            $.ajax({
                url: '/Orders/AllCitiesOfProvince/', //controller and action
                data: { _provinceId: provinceId }, // Send the product ID as a parameter
                dataType: 'html',
                success: function (data) {
                    $('#cities-select').html(data); // Insert the received HTML into the container
                }
            });
        }else{
            console.log("aksjhfjkasdhfkjhsdakjfhaskdjhk");
            const citiesSelect = document.getElementById("cities-select");
            citiesSelect.innerHTML = "";
            const option = document.createElement("option");
            option.value = -1;
            option.text = "انتخاب شهر";
            citiesSelect.appendChild(option);
        }

    }
</script>