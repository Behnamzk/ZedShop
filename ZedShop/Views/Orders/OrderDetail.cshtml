@using ZedShop.Core.DTOs.Order
@model OrderDetailViewModel
@{
    ViewData["Title"] = "جزئیات سفارش";
}
<h3 style="margin: 1% 10.7% 2% 0%">جزئیات سفارش</h3>

<div class="row" style="width:100%; max-width:100%;">
    <div class="column left" style="width: 20%;"> </div>
    <div class="column middle" style="width: 60%;">
        <div class="scrollmenu">
            @foreach (var item in Model.Products)
            {
                <div class="orderproductbox">

                    <div class="orderproductframe">
                        <img src="/Products/Image/@item.ProductImageName" alt="Product Image">
                        <label>@item.Name</label>
                        <label>@item.Count</label>
                        <label>@item.SellPrice.ToString("N0") تومان</label>

                    </div>


                </div>

            }
        </div>
        <p class="orderdetailp">هزینه محصولات با تخفیف: @Model.ProductsPrice</p>
        <p class="orderdetailp">هزینه پست: @Model.PostPrice</p>
        <p class="orderdetailp"><strong>مجموع هزینه‌ها: @Model.TotalPrice</strong></p>
         
        <p class="orderdetailp" style="margin-top:10px;"><strong>وضعیت سفارش: @Model.OrderStatus</strong></p>
        <p class="orderdetailp">تاریخ بروزرسانی: @Model.OrderDate</p>
        <p class="orderdetailp">تخفیف: @Model.Discount</p>
        <p class="orderdetailp">توضیحات: @Model.OrderDescription</p>
        <p class="orderdetailp">آدرس: @Model.AddressVM</p>
        <p class="orderdetailp">توضیحات پست: @Model.PostDelivery</p>
    </div>
    <div class="column right" style="width: 20%;"> </div>
</div>
